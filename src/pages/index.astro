---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Dimas Falah — UI/UX Designer & Frontend Developer',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Section (Header Utama) -->
  <div class="pt-12 sm:pt-16 md:pt-24 pb-8">
    <Hero
      tagline="Personal Portfolio"
      actions={[
        {
          variant: 'primary',
          text: 'Hubungi Saya',
          href: '#contact',
          icon: 'tabler:mail',
        },
        { text: 'Lihat Proyek', href: '#projects' },
      ]}
      image={{ src: '~/assets/images/hero-image.png', alt: 'Dimas Falah Portfolio' }}
    >
      <Fragment slot="title">
        Halo, Saya <span class="text-accent dark:text-white">Dimas Falah</span>
      </Fragment>

      <Fragment slot="subtitle">
        Seorang UI/UX Designer & Frontend Developer yang berfokus pada perancangan antarmuka visual interaktif serta pengembangan aplikasi web modern yang responsif.
      </Fragment>
    </Hero>
  </div>

  <!-- Tentang Saya (About) -->
  <Content
    id="about"
    tagline="Tentang Saya"
    title="Menciptakan Pengalaman Digital Berbasis Desain & Kode"
    items={[
      {
        title: 'User-Centered Design',
        description: 'Mendesain antarmuka yang intuitif dan ramah pengguna berdasarkan kebutuhan nyata audiens.',
      },
      {
        title: 'Pengembangan Web Responsif',
        description: 'Menerjemahkan desain visual menjadi kode Frontend yang bersih, efisien, dan optimal di semua perangkat.',
      },
      {
        title: 'Kolaborasi Interdisipliner',
        description: 'Mampu menjembatani ide desain visual dengan batasan teknis pemrograman secara efektif.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Dimas Falah Workspace',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Profil Ringkas</h3>
      Selamat datang di portofolio saya! Saya memiliki minat mendalam dalam dunia desain antarmuka (UI/UX) dan pengembangan tampilan web (Frontend Development).
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Keahlian & Tools (Skills) -->
  <Features2
    id="skills"
    tagline="Keahlian"
    title="Teknologi & Tools"
    subtitle="Berikut adalah perangkat lunak dan teknologi yang biasa saya gunakan dalam alur kerja harian"
    items={[
      {
        title: 'UI/UX Design',
        description: 'Wireframing, Prototyping, Responsive Design, Design Thinking, Figma',
        icon: 'tabler:palette',
      },
      {
        title: 'Frontend Development',
        description: 'HTML5, CSS3, JavaScript, Tailwind CSS, React, React Native, Astro',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Tools & Workflow',
        description: 'Git, GitHub, VS Code, Vercel, Figma, Ms Office',
        icon: 'flat-color-icons:approval',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Section Proyek (Projects) -->

  <!-- Proyek 1 -->
  <Content
    id="projects"
    tagline="Portofolio"
    title="Proyek Yang Pernah Dikerjakan"
    subtitle="Beberapa hasil karya perancangan antarmuka dan aplikasi web yang telah saya kembangkan"
    isReversed
    items={[
      {
        title: 'Fokus Desain & Fitur',
        description: 'Eksplorasi UI/UX interaktif, sistem komponen konsisten, serta alur navigasi pengguna yang seamless.',
      },
      {
        title: 'Teknologi & Tools',
        description: 'Figma, React, Tailwind CSS, dan Vercel Deployment.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1600&q=80',
      alt: 'Tampilan Proyek 1',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Redesain / Desain Aplikasi Web
      </h3>
      Perancangan ulang antarmuka aplikasi web untuk meningkatkan kenyamanan visual dan pengalaman pengguna (User Experience).
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Proyek 2 -->
  <Content
    isAfterContent
    items={[
      {
        title: 'Fokus Desain & Fitur',
        description: 'Desain ultra-responsif, animasi mikro yang halus, dan performa pemuatan halaman yang sangat cepat.',
      },
      {
        title: 'Teknologi & Tools',
        description: 'Astro, Tailwind CSS, Figma, TypeScript, Vercel.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1600&q=80',
      alt: 'Tampilan Proyek 2',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Sistem Informasi / Landing Page Modern
      </h3>
      Pengembangan landing page interaktif dengan memprioritaskan estetika visual modern serta skor performa Lighthouse yang optimal.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Pengalaman & Pendidikan (Timeline) -->
  <Timeline
    id="experience"
    tagline="Riwayat"
    title="Pengalaman & Pendidikan"
    subtitle="Latar belakang pendidikan dan alur perjalanan saya di bidang desain dan teknologi"
    items={[
      {
        date: '2022 - Sekarang',
        title: 'Pendidikan / Studi',
        description: 'Mempelajari dasar rekayasa perangkat lunak, perancangan antarmuka, dan struktur data.',
        icon: 'tabler:school',
      },
      {
        date: '2023 - Sekarang',
        title: 'Eksplorasi UI/UX & Frontend Development',
        description: 'Merancang *wireframe*, *high-fidelity prototype* di Figma, dan mengimplementasikannya menjadi kode Frontend.',
        icon: 'tabler:code',
      },
    ]}
  />

  <!-- Call To Action (Kontak) -->
  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'Kirim Email',
        href: 'mailto:emailkamu@gmail.com',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Mari Bekerja Sama!
    </Fragment>

    <Fragment slot="subtitle">
      Tertarik untuk berdiskusi tentang proyek desain, pengembangan web, atau peluang kolaborasi? Silakan hubungi saya.
    </Fragment>
  </CallToAction>
</Layout>
