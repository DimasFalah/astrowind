---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

// Import Gambar Lokal
import myProfileImg from '~/assets/images/profil.jpg';
import project1Img from '~/assets/images/proyek1.png';
import project2Img from '~/assets/images/proyek2.png';

const metadata = {
  title: 'Dimas Falah — UI/UX Designer & Frontend Developer',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Background Glow -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[450px] bg-purple-500/10 dark:bg-purple-600/15 rounded-full blur-[140px]"></div>
    <div class="absolute top-1/2 -left-40 w-[500px] h-[500px] bg-indigo-500/10 dark:bg-indigo-600/10 rounded-full blur-[160px]"></div>
    <div class="absolute bottom-10 right-10 w-[600px] h-[600px] bg-purple-500/10 dark:bg-purple-900/15 rounded-full blur-[150px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#000000_1px,transparent_1px)] dark:bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.03]"></div>
  </div>

  <!-- Hero Container -->
  <section class="pt-20 sm:pt-28 pb-12 sm:pb-16 relative flex flex-col items-center justify-center min-h-[calc(100vh-80px)]">
    <Hero>
      <Fragment slot="title">
        <div class="flex justify-center mb-3 sm:mb-4">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-100 dark:bg-purple-950/80 border border-purple-300 dark:border-purple-500/40 text-sm sm:text-base font-semibold text-purple-700 dark:text-purple-300 backdrop-blur-md shadow-sm">
            <span class="w-2 h-2 rounded-full bg-purple-600 dark:bg-purple-400 animate-pulse shrink-0"></span>
            <span class="whitespace-nowrap tracking-normal" style="word-spacing: 0.15em;" data-i18n="hero_badge">Halo, Saya</span>
          </span>
        </div>
        
        <span class="block text-5xl sm:text-7xl font-black tracking-tight bg-gradient-to-r from-purple-600 via-fuchsia-500 to-indigo-600 dark:from-purple-300 dark:via-fuchsia-300 dark:to-indigo-300 bg-clip-text text-transparent drop-shadow-sm py-1">
          Dimas Falah
        </span>
      </Fragment>

      <Fragment slot="subtitle">
        <span data-i18n="hero_role_prefix">Seorang</span> <span class="text-slate-900 dark:text-white font-semibold">UI/UX Designer</span> & <span class="text-slate-900 dark:text-white font-semibold">Frontend Developer</span> <span data-i18n="hero_desc">yang berfokus pada perancangan antarmuka visual bersih interaktif serta aplikasi web modern.</span>
      </Fragment>

      <Fragment slot="actions">
        <div class="flex max-w-sm gap-4 flex-col sm:flex-row justify-center mx-auto">
          <a
            class="btn-primary flex items-center justify-center px-6 py-3 rounded-full font-semibold shadow-md gap-2"
            href="#contact"
          >
            <span data-i18n="btn_contact">Hubungi Saya</span>
          </a>
          <a
            class="btn-secondary flex items-center justify-center px-6 py-3 rounded-full font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
            href="#projects"
          >
            <span data-i18n="btn_projects">Lihat Proyek</span>
          </a>
        </div>
      </Fragment>
    </Hero>
  </section>

  <!-- Tentang Saya (About) -->
  <div id="about" data-aos="fade-up" class="pt-12">
    <div class="text-center max-w-3xl mx-auto mb-8 px-4">
      <p class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1" data-i18n="about_tagline">Tentang Saya</p>
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight" data-i18n="about_title">Menciptakan Pengalaman Digital Berbasis Desain & Kode</h2>
    </div>

    <Content
      image={{
        src: myProfileImg,
        alt: 'Foto Dimas Falah',
      }}
    >
      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl mb-2" data-i18n="about_profile_title">Profil Ringkas</h3>
        <p class="mb-6 text-slate-600 dark:text-slate-400" data-i18n="about_profile_desc">Selamat datang di portofolio saya! Saya memiliki minat mendalam dalam dunia desain antarmuka (UI/UX) dan pengembangan tampilan web (Frontend Development).</p>

        <div class="space-y-4">
          <!-- Point 1: Design Thinking -->
          <div class="flex items-start gap-3">
            <div class="p-1 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 mt-1 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white" data-i18n="about_item_1_title">Design Thinking Approach</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400" data-i18n="about_item_1_desc">Mendalami masalah pengguna secara empati untuk merancang solusi UI/UX yang relevan, intuitif, dan bernilai bisnis.</p>
            </div>
          </div>

          <!-- Point 2: Web & App Development -->
          <div class="flex items-start gap-3">
            <div class="p-1 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 mt-1 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white" data-i18n="about_item_2_title">Web & App Development</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400" data-i18n="about_item_2_desc">Mengembangkan aplikasi web dan mobile yang responsif, terstruktur, serta memiliki performa tinggi.</p>
            </div>
          </div>

          <!-- Point 3: Kolaboratif & Komunikatif -->
          <div class="flex items-start gap-3">
            <div class="p-1 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 mt-1 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white" data-i18n="about_item_3_title">Kolaboratif & Komunikatif</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400" data-i18n="about_item_3_desc">Pemain tim yang adaptif, siap bekerja sama lintas fungsi (Developer, PM, Designer) dengan komunikasi yang terbuka dan produktif.</p>
            </div>
          </div>
        </div>
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-transparent"></div>
      </Fragment>
    </Content>
  </div>

  <!-- Keahlian (Skills) -->
  <div id="skills" data-aos="fade-up" class="py-12 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <p class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1" data-i18n="skills_tagline">Keahlian</p>
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-3" data-i18n="skills_title">Teknologi & Tools</h2>
      <p class="text-slate-600 dark:text-slate-400 text-base" data-i18n="skills_subtitle">Perangkat lunak dan teknologi yang saya gunakan untuk mewujudkan konsep desain menjadi produk nyata</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- UI/UX Design -->
      <div class="group relative p-6 rounded-2xl bg-slate-50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/[0.05] border border-slate-200 dark:border-white/5 transition-all duration-300">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">UI/UX Design</h3>
        <div class="flex flex-wrap gap-2 mt-3">
          <span class="px-2.5 py-1 text-xs rounded-full bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-200">Wireframing</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-200">Prototyping</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-200">Design System</span>
        </div>
      </div>

      <!-- Frontend Dev -->
      <div class="group relative p-6 rounded-2xl bg-slate-50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/[0.05] border border-slate-200 dark:border-white/5 transition-all duration-300">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Frontend Dev</h3>
        <div class="flex flex-wrap gap-2 mt-3">
          <span class="px-2.5 py-1 text-xs rounded-full bg-indigo-100 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-200">JavaScript</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-indigo-100 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-200">React</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-indigo-100 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-200">HTML</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-indigo-100 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-200">CSS</span>
        </div>
      </div>

      <!-- Tools & Workflow -->
      <div class="group relative p-6 rounded-2xl bg-slate-50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/[0.05] border border-slate-200 dark:border-white/5 transition-all duration-300">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Tools & Workflow</h3>
        <div class="flex flex-wrap gap-2 mt-3">
          <span class="px-2.5 py-1 text-xs rounded-full bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-200">Figma</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-200">Git & GitHub</span>
          <span class="px-2.5 py-1 text-xs rounded-full bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-200">VS Code</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Proyek (Projects) -->
  <div id="projects" class="space-y-8 my-8 pt-8">
    <div class="text-center max-w-3xl mx-auto mb-6 px-4">
      <p class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1" data-i18n="projects_tagline">Portofolio</p>
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight" data-i18n="projects_title">Proyek Yang Pernah Dikerjakan</h2>
    </div>

    <!-- Proyek 1 -->
    <div data-aos="fade-up">
      <Content
        isReversed
        image={{
          src: project1Img,
          alt: 'Tampilan Redesign Mobile JKN App',
          class: 'bg-transparent shadow-none border-none p-0',
        }}
      >
        <Fragment slot="content">
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Redesign Mobile JKN App</h3>
          <p class="mb-6 text-slate-600 dark:text-slate-400" data-i18n="project_1_desc">Perancangan ulang antarmuka aplikasi mobile JKN untuk meningkatkan aksesibilitas layanan kesehatan, kenyamanan visual, serta pengalaman pengguna (User Experience).</p>

          <div class="space-y-3">
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm" data-i18n="project_focus_title">Fokus Desain & Fitur</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400" data-i18n="project_1_focus_desc">Redesain UI/UX berbasis kebutuhan pengguna, penyederhanaan alur navigasi fitur utama (Kartu Digital & Antrean Online), serta konsistensi sistem desain.</p>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm" data-i18n="project_tech_title">Teknologi & Tools</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400">JavaScript, React Native, Tailwind CSS, Visual Studio Code, Figma.</p>
            </div>
          </div>
        </Fragment>
      </Content>
    </div>

    <!-- Proyek 2 -->
    <div data-aos="fade-up">
      <Content
        isAfterContent
        image={{
          src: project2Img,
          alt: 'Tampilan Task Management Dashboard',
          class: 'bg-transparent shadow-none border-none p-0',
        }}
      >
        <Fragment slot="content">
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Task Management Dashboard</h3>
          <p class="mb-6 text-slate-600 dark:text-slate-400" data-i18n="project_2_desc">Perancangan dan pengembangan platform manajemen tugas interaktif untuk mempermudah kolaborasi tim serta pemantauan progress proyek secara berkala.</p>

          <div class="space-y-3">
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm" data-i18n="project_focus_title">Fokus Desain & Fitur</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400" data-i18n="project_2_focus_desc">Desain ultra-responsif, manajemen tugas interaktif, visualisasi status proyek, dan performa pemuatan halaman yang sangat cepat.</p>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm" data-i18n="project_tech_title">Teknologi & Tools</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400">HTML, JavaScript, Tailwind CSS, Visual Studio Code, Figma.</p>
            </div>
          </div>
        </Fragment>
      </Content>
    </div>
  </div>

  <!-- Pengalaman & Pendidikan (Riwayat / Experience) -->
  <div id="experience" data-aos="fade-up" class="py-16 max-w-4xl mx-auto px-4 sm:px-6 scroll-mt-24">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1" data-i18n="exp_tagline">Riwayat</p>
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-3" data-i18n="exp_title">Pengalaman & Pendidikan</h2>
      <p class="text-slate-600 dark:text-slate-400 text-base" data-i18n="exp_subtitle">Latar belakang pendidikan dan alur perjalanan saya di bidang desain dan teknologi</p>
    </div>

    <!-- Timeline Wrapper (Diurutkan dari yang terbaru) -->
    <div class="relative border-l-2 border-purple-200 dark:border-purple-900/60 ml-4 sm:ml-36 space-y-10">
      
      <!-- 1. Magang Kemenkes RI -->
      <div class="relative pl-6 sm:pl-8">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-purple-600 dark:bg-purple-400 border-4 border-white dark:border-slate-900"></div>
        <span class="sm:absolute sm:-left-36 sm:top-0.5 text-sm font-semibold text-purple-600 dark:text-purple-400 block mb-1 sm:mb-0" data-i18n="exp_date_1">Jan 2025 - Mar 2025</span>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white" data-i18n="exp_item_1_title">UI/UX Designer & Developer Intern — Kemenkes RI</h3>
        <p class="mt-1 text-slate-600 dark:text-slate-400 text-sm leading-relaxed" data-i18n="exp_item_1_desc">Berkontribusi dalam pengembangan dan perancangan antarmuka sistem/aplikasi layanan kesehatan digital di lingkungan Kementerian Kesehatan Republik Indonesia.</p>
      </div>

      <!-- 2. Kuliah UNPAD -->
      <div class="relative pl-6 sm:pl-8">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-purple-600 dark:bg-purple-400 border-4 border-white dark:border-slate-900"></div>
        <span class="sm:absolute sm:-left-36 sm:top-0.5 text-sm font-semibold text-purple-600 dark:text-purple-400 block mb-1 sm:mb-0" data-i18n="exp_date_2">2021 - 2026</span>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white" data-i18n="exp_item_2_title">Universitas Padjadjaran</h3>
        <p class="mt-1 text-slate-600 dark:text-slate-400 text-sm leading-relaxed" data-i18n="exp_item_2_desc">Mempelajari dasar rekayasa perangkat lunak, pemrograman web, perancangan antarmuka pengguna (UI/UX), dan struktur data.</p>
      </div>

      <!-- 3. SMAN 46 Jakarta -->
      <div class="relative pl-6 sm:pl-8">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-purple-600 dark:bg-purple-400 border-4 border-white dark:border-slate-900"></div>
        <span class="sm:absolute sm:-left-36 sm:top-0.5 text-sm font-semibold text-purple-600 dark:text-purple-400 block mb-1 sm:mb-0" data-i18n="exp_date_3">2018 - 2021</span>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white" data-i18n="exp_item_3_title">SMAN 46 Jakarta</h3>
        <p class="mt-1 text-slate-600 dark:text-slate-400 text-sm leading-relaxed" data-i18n="exp_item_3_desc">Menyelesaikan pendidikan menengah atas serta aktif mengembangkan minat awal di bidang teknologi dan komputer.</p>
      </div>

    </div>
  </div>

  <!-- Call To Action (Kontak) -->
  <div id="contact" data-aos="fade-up" class="py-20 max-w-4xl mx-auto text-center px-4 scroll-mt-24">
    <div class="relative py-12 px-6 rounded-3xl bg-purple-50/60 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-500/20 backdrop-blur-sm overflow-hidden">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight relative z-10" data-i18n="contact_title">
        Punya Ide Proyek Menarik?
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300 text-base max-w-lg mx-auto relative z-10" data-i18n="contact_desc">
        Saya selalu terbuka untuk diskusi mengenai perancangan UI/UX, kolaborasi pengembangan web, atau peluang kerja.
      </p>

      <!-- Tombol Kontak Email & WhatsApp -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10">
        <!-- Button Email -->
        <a
          href="mailto:dfalahaw@gmail.com"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold text-sm shadow-lg hover:scale-105 transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          <span>dfalahaw@gmail.com</span>
        </a>

        <!-- Button WhatsApp -->
        <a
          href="https://wa.me/6281210907537" 
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-lg hover:scale-105 transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>WhatsApp Chat</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<!-- Client Script Penerjemah Otonom -->
<script>
  import { translations } from '~/utils/translations';

  function updatePageLanguage(lang: string) {
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && translations[lang] && translations[lang][key]) {
        el.textContent = translations[lang][key];
      }
    });
  }

  function initTranslationEngine() {
    let currentLang = localStorage.getItem('app_lang') || 'en';
    updatePageLanguage(currentLang);

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const btn = target.closest('button, a, div');
      if (btn) {
        const text = btn.textContent?.trim().toUpperCase();
        if (text === 'EN' || text === 'ID' || btn.classList.contains('lang-switcher')) {
          currentLang = currentLang === 'en' ? 'id' : 'en';
          localStorage.setItem('app_lang', currentLang);
          updatePageLanguage(currentLang);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTranslationEngine);
  } else {
    initTranslationEngine();
  }
</script>