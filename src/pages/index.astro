---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Dimas Falah — Personal Portfolio',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Section (Header Utama) -->
  <div class="pt-12 sm:pt-16 md:pt-24 pb-8">
    <Hero
      tagline="Personal Portfolio"
      actions={[
        {
          variant: 'primary',
          text: 'Hubungi Saya',
          href: '#contact',
          icon: 'tabler:mail',
        },
        { text: 'Lihat Proyek', href: '#projects' },
      ]}
      image={{ src: '~/assets/images/hero-image.png', alt: 'Dimas Falah Portfolio' }}
    >
      <Fragment slot="title">
        Halo, Saya <span class="text-accent dark:text-white">Dimas Falah</span>
      </Fragment>

      <Fragment slot="subtitle">
        Seorang Software Engineer / Web Developer yang berfokus pada pengembangan aplikasi web modern, responsif, dan performan tinggi.
      </Fragment>
    </Hero>
  </div>

  <!-- Tentang Saya (About) -->
  <Content
    id="about"
    tagline="Tentang Saya"
    title="Membangun Solusi Digital dengan Teknologi Modern"
    items={[
      {
        title: 'Pengembangan Web Responsif',
        description: 'Membangun antarmuka yang ramah pengguna dan optimal di semua ukuran layar.',
      },
      {
        title: 'Kode Bersih & Efisien',
        description: 'Menerapkan praktik terbaik dalam penulisan kode untuk kemudahan pemeliharaan jangka panjang.',
      },
      {
        title: 'Kolaborasi & Komunikasi',
        description: 'Terbiasa bekerja dalam tim maupun mandiri untuk menyelesaikan masalah bisnis.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Dimas Falah Workspace',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Profil Ringkas</h3>
      Selamat datang di portofolio saya! Saya memiliki passion dalam dunia teknologi web dan pengembangan perangkat lunak.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

<!-- Keahlian & Teknologi (Skills) -->
  <Features2
    id="skills"
    tagline="Keahlian"
    title="Teknologi & Tools"
    subtitle="Berikut adalah beberapa teknologi dan tools yang biasa saya gunakan dalam pengerjaan proyek"
    items={[
      {
        title: 'UI/UX Design',
        description: 'Wireframing, Prototyping, Responsive Design, Design Thinking',
        icon: 'flat-color-icons:design',
      },
      {
        title: 'Frontend Development',
        description: 'HTML5, CSS3, JavaScript, Tailwind CSS, React, React Native',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Tools & Workflow',
        description: 'Git, GitHub, VS Code, Vercel, Figma, Ms Office',
        icon: 'flat-color-icons:approval',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Section Proyek (Projects) ****************** -->

  <!-- Proyek 1 -->
  <Content
    id="projects"
    tagline="Portofolio"
    title="Proyek Yang Pernah Dikerjakan"
    subtitle="Beberapa hasil karya dan aplikasi web yang telah saya kembangkan"
    isReversed
    items={[
      {
        title: 'Fitur Utama',
        description: 'Autentikasi pengguna, Dashboard interaktif, manajemen data, dan integrasi Payment Gateway.',
      },
      {
        title: 'Teknologi Diterapkan',
        description: 'React, Node.js, Express, Tailwind CSS, dan PostgreSQL.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1600&q=80',
      alt: 'Proyek 1 Display',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Aplikasi Web E-Commerce / SaaS
      </h3>
      Platform aplikasi web interaktif yang dirancang untuk mempermudah transaksi dan pengelolaan data secara *real-time*.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Proyek 2 -->
  <Content
    isAfterContent
    items={[
      {
        title: 'Fitur Utama',
        description: 'Desain ultra-responsif, Optimasi SEO tinggi, dan pemuatan halaman kurang dari 1 detik.',
      },
      {
        title: 'Teknologi Diterapkan',
        description: 'Astro, Tailwind CSS, TypeScript, Vercel Deployment.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1600&q=80',
      alt: 'Proyek 2 Display',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Sistem Informasi / Company Profile
      </h3>
      Website modern dengan performa dan skor Lighthouse sempurna untuk meningkatkan kredibilitas merek atau profil institusi.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Pengalaman / Perjalanan (Timeline) -->
  <Timeline
    id="experience"
    tagline="Riwayat"
    title="Pengalaman & Pendidikan"
    subtitle="Latar belakang pendidikan dan pengalaman dalam pengembangan proyek"
    items={[
      {
        date: '2022 - Sekarang',
        title: 'Pendidikan / Studi',
        description: 'Fokus pada pengembangan ilmu komputer, struktur data, dan rekayasa perangkat lunak.',
        icon: 'tabler:school',
      },
      {
        date: '2023 - Sekarang',
        title: 'Pengembangan Proyek Web',
        description: 'Merancang dan membangun berbagai aplikasi web portofolio, sistem informasi, serta proyek klien.',
        icon: 'tabler:code',
      },
    ]}
  />

  <!-- Call To Action (Kontak) -->
  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'Kirim Email',
        href: 'mailto:emailkamu@gmail.com',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Mari Bekerja Sama!
    </Fragment>

    <Fragment slot="subtitle">
      Tertarik untuk berdiskusi tentang proyek atau peluang kerja sama? Jangan ragu untuk menghubungi saya.
    </Fragment>
  </CallToAction>
</Layout>
