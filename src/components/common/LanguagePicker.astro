      history_subtitle: 'Latar belakang pendidikan dan alur perjalanan saya di bidang desain dan teknologi',
      contact_title: 'Punya Ide Proyek Menarik?',
      contact_desc: 'Saya selalu terbuka untuk diskusi mengenai perancangan UI/UX, kolaborasi pengembangan web, atau peluang kerja harian.',
      contact_btn: 'Mari Bekerja Sama',
    },
    en: {
      nav_about: 'About Me',
      nav_skills: 'Skills',
      nav_experience: 'Experience',
      nav_contact: 'Contact',
      hero_badge: "Hi, I'm",
      hero_role_prefix: 'An',
      hero_desc: 'focused on designing clean, interactive visual interfaces and modern web applications.',
      btn_contact: 'Contact Me',
      btn_projects: 'View Projects',
      about_tagline: 'About Me',
      about_title: 'Creating Digital Experiences Driven by Design & Code',
      about_profile_title: 'Brief Profile',
      about_profile_desc: 'Welcome to my portfolio! I have a deep passion for user interface design (UI/UX) and frontend web development.',
      skills_tagline: 'Skills',
      skills_title: 'Technologies & Tools',
      skills_subtitle: 'Software and technologies I use to bring design concepts into real products',
      projects_tagline: 'Portfolio',
      projects_title: 'Featured Projects',
      project_1_desc: 'Redesigning the Mobile JKN interface to improve healthcare service accessibility, visual comfort, and overall user experience.',
      project_2_desc: 'Designing and developing an interactive task management platform to streamline team collaboration and project progress tracking.',
      history_tagline: 'History',
      history_title: 'Experience & Education',
      history_subtitle: 'My educational background and journey in design and technology',
      contact_title: 'Have an Interesting Project Idea?',
      contact_desc: 'I am always open to discussing UI/UX design, web development collaboration, or work opportunities.',
      contact_btn: "Let's Work Together",
    },
  };

  function applyLanguage(lang) {
    const dict = translations[lang];
    if (!dict) return;

    // Ubah semua elemen yang punya atribut data-i18n
    const elements = document.querySelectorAll('[data-i18n]');
    elements.forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key] !== undefined) {
        el.textContent = dict[key];
      }
    });

    // Ubah label indikator di tombol
    const labels = document.querySelectorAll('#lang-text');
    labels.forEach((label) => {
      label.textContent = lang.toUpperCase();
    });

    localStorage.setItem('app_lang', lang);
  }

  function initLang() {
    const savedLang = localStorage.getItem('app_lang') || 'id';
    applyLanguage(savedLang);
  }

  // Event listener tombol
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('#lang-toggle');
    if (btn) {
      const current = localStorage.getItem('app_lang') || 'id';
      const next = current === 'id' ? 'en' : 'id';
      applyLanguage(next);
    }
  });

  // Jalankan saat load awal & navigasi Astro
  document.addEventListener('astro:page-load', initLang);
  document.addEventListener('DOMContentLoaded', initLang);
  initLang();
</script>